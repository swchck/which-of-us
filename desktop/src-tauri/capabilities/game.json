{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game",
  "description": "The TV page served by the local game server; it may only toggle fullscreen and drag the frameless window.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging"
  ]
}
