{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "game",
  "description": "The TV page served by the local game server; it may toggle fullscreen, drag the frameless window and fetch the downloadable voice.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-start-dragging",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-voice-state",
    "allow-voice-install",
    "allow-voice-cancel"
  ]
}
